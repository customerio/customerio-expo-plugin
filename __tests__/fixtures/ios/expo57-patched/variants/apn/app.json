{
  "expo": {
    "name": "LifecycleFixture_Expo57",
    "slug": "LifecycleFixture_Expo57",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifecyclefixtureexpo57",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.test.lifecyclefixtureexpo57",
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.customer.testbed.expo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "customerio-expo-plugin",
        {
          "config": {
            "cdpApiKey": "dummy-cdp-api-key",
            "region": "us",
            "siteId": "dummy-site-id"
          },
          "android": {
            "googleServicesFile": "./cio-artifacts/google-services.json",
            "setHighPriorityPushHandler": true,
            "pushNotification": {
              "channel": {
                "id": "cio-expo-id",
                "name": "CIO Test",
                "importance": 4
              }
            }
          },
          "ios": {
            "pushNotification": {
              "useRichPush": true,
              "appGroupId": "group.io.customer.testbed.expo.apn.cio",
              "handleDeeplinkInKilledState": true,
              "provider": "apn"
            }
          }
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
