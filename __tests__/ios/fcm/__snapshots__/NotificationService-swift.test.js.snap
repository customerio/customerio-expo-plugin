exports[`Plugin creates expected NotificationService.swift 1`] = `
"import Foundation
import UserNotifications
import CioMessagingPushFCM

@objc
public class NotificationServiceCioManager : NSObject {
  
  public override init() {}
  
  @objc(didReceive:withContentHandler:)
  public func didReceive(_ request: UNNotificationRequest, withContentHandler contentHandler: @escaping (UNNotificationContent) -> Void) {
    MessagingPushFCM.initializeForExtension(
      withConfig: MessagingPushConfigBuilder(cdpApiKey: Env.customerIOCdpApiKey)
        .region(Env.customerIORegion)
        .appGroupId("group.io.customer.testbed.expo.apn.cio")
        .build()
    )
    
    // \`didReceive\` returns false for pushes Customer.io didn't send (for example from another
    // push provider) and then never calls the handler, so deliver those unchanged instead of
    // leaving iOS to show them when the extension times out. Some SDK versions also call the
    // handler themselves before returning false (SDK not initialized), hence the guard.
    var delivered = false
    let deliver: (UNNotificationContent) -> Void = { content in
      guard !delivered else { return }
      delivered = true
      contentHandler(content)
    }
    if !MessagingPush.shared.didReceive(request, withContentHandler: deliver) {
      deliver(request.content)
    }
  }
  
  @objc(serviceExtensionTimeWillExpire)
  public func serviceExtensionTimeWillExpire() {
    MessagingPush.shared.serviceExtensionTimeWillExpire()
  }
}
"
`;
